# ──────────────────────────────────────────────
# HustleKingdom — Environment Configuration
# Copy this to config/.env and fill in your values.
# NEVER commit config/.env to git.
# ──────────────────────────────────────────────

# App
APP_NAME="Hustle Kingdom"
APP_URL="https://hustlekingdom.app"
APP_ENV="production"
APP_DEBUG="false"

# Database (cPanel → MySQL Databases)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="your_db_name"
DB_USER="your_db_user"
DB_PASS="your_db_password"

# Paystack (dashboard.paystack.com → Settings → API Keys)
PAYSTACK_SECRET_KEY="sk_live_xxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="your_webhook_secret"
